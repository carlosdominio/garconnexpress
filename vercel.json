{
  "version": 2,
  "regions": ["gru1"],
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "frontend/**",
          "motoboy-app-nativo/www/**",
          "cozinha-app-nativo/www/**",
          "garcom-app-nativo/www/**",
          "churrasqueiro-app-nativo/www/**",
          "routes/**"
        ]
      }
    },
    {
      "src": "*.apk",
      "use": "@vercel/static"
    }
  ],
  "headers": [
    {
      "source": "/(garcom-v1.1.0-portrait.apk|cozinha-v1.1.0-portrait.apk|motoboy-v2.0.0-portrait.apk|churrasqueiro-final.apk)",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment"
        },
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:mp3|wav|png|jpg|webp|svg|ico|woff2))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/server.js" }
  ]
}