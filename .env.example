# Configurações do Servidor
PORT=3000
NODE_ENV=development

# Autenticação e Segurança
JWT_SECRET=sua_chave_jwt_secreta_aqui
CRON_SECRET=sua_chave_cron_secreta_aqui
BOT_SECRET=sua_chave_bot_whatsapp_secreta_aqui

# Pusher Realtime (Credenciais do Painel Pusher)
PUSHER_APP_ID=seu_pusher_app_id
PUSHER_APP_KEY=sua_pusher_app_key
PUSHER_APP_SECRET=sua_pusher_app_secret
PUSHER_CLUSTER=sa1

# Banco de Dados (PostgreSQL / Supabase / Neon)
DATABASE_URL=postgresql://usuario:senha@host:5432/garconnexpress
# POSTGRES_URL=postgresql://usuario:senha@host:5432/garconnexpress
