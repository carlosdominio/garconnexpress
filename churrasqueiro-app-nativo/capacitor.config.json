{
  "appId": "com.garconnexpress.churrasqueiro",
  "appName": "ChurrasqueiroExpress",
  "webDir": "www",
  "plugins": {
    "PushNotifications": {
      "presentationOptions": []
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_notification",
      "iconColor": "#e67e22",
      "sound": "notificacao.mp3"
    },
    "SplashScreen": {
      "launchShowDuration": 3500,
      "launchAutoHide": true,
      "backgroundColor": "#1e293b",
      "androidSplashResourceName": "splash",
      "showSpinner": true,
      "androidSpinnerStyle": "large",
      "spinnerColor": "#e67e22"
    }
  },
  "cordova": {
    "preferences": {
      "MediaPlaybackRequiresUserAction": "false"
    }
  }
}
